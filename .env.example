# NEXUS — plantilla de configuración. Copia este archivo a `.env` (misma carpeta) y rellena los valores.
# `.env` no se sube a git. Explicación de cada variable: CONFIGURACION.md

# --- Obligatorias ---
NEXUS_DB_PASSWORD=cambia-esto-por-una-clave-larga
NEXUS_API_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# --- Modelo de lenguaje (elige uno; sin ninguno NEXUS arranca pero no genera texto) ---
NEXUS_GGUF_PATH=C:/ruta/modelos/Qwen2.5-7B-Instruct-Q4_K_M.gguf;C:/ruta/modelos/Qwen3-4B-Q4_K_M.gguf
# NEXUS_GGUF_GPU_LAYERS=auto
# NEXUS_GGUF_CTX=4096
# NEXUS_MODEL=paquete.modulo:Clase

# --- Embeddings para buscar en documentos (recomendado) ---
# NEXUS_EMBED_MODEL_DIR=C:/ruta/paraphrase-multilingual-MiniLM-L12-v2
# NEXUS_RAG_MAX_DISTANCE=0.6

# --- Carpetas que NEXUS puede leer y sincronizar ---
# NEXUS_FOLDER_ROOTS=C:/Users/tu-usuario/Documents/Notas;D:/Proyectos

# --- OCR (opcional; se detecta solo en la ruta estándar) ---
# NEXUS_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# NEXUS_TESSDATA_DIR=C:/ruta/tessdata
# NEXUS_OCR_LANGUAGES=spa+eng

# --- Conectores ---
# NEXUS_GITHUB_TOKEN=token-fine-grained-de-solo-lectura

# --- Avanzado ---
# NEXUS_DATABASE_URL=postgresql+psycopg://nexus:clave@127.0.0.1:5432/nexus
# NEXUS_MODELS_DIR=C:/ruta/artefactos
# NEXUS_FRONTEND_DIST=C:/ruta/frontend/dist
